  "keyFeatures": [
    "Isolated Kubernetes sandbox execution for coding agents",
    "Credential vault proxy — agents see only stub tokens, never real secrets",
    "Multiple harness types: Claude Code, Codex (TUI), opencode, claude-agent-sdk (API)",
    "`lap` CLI for attaching a local terminal to a remote sandbox over WebSocket",
    "Warm pool — pre-provisioned sandbox pods for sub-2s session starts",
    "Skills library — reusable system-prompt blocks attached to agents",
    "Per-agent and per-session memory store",
    "Linear OAuth integration — delegate Linear issues to agents automatically",
    "REST API for programmatic agent and session management",
    "Self-hostable on Kubernetes (kind for local dev, EKS / GKE / AKS for production)"
  ],
  "publicApiSurface": [
    "GET  /api/v1/managed_agents/agents",
